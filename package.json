{
  "name": "ursa-arcana",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy": "hardhat run scripts/deploy.cjs --network arcTestnet",
    "contracts:deploy:nft": "hardhat run scripts/deploy-nft.cjs --network arcTestnet",
    "contracts:deploy:collections": "hardhat run scripts/deploy-collections.cjs --network arcTestnet",
    "contracts:deploy:utilities": "hardhat run scripts/deploy-utilities.cjs --network arcTestnet",
    "contracts:allowlist": "hardhat run scripts/allowlist-nft.cjs --network arcTestnet",
    "contracts:verify:utilities": "hardhat run scripts/verify-utilities.cjs --network arcTestnet",
    "contracts:smoke:mint": "hardhat run scripts/smoke-mint.cjs --network arcTestnet",
    "assets:generate": "node scripts/generate-assets.cjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "viem": "^2.22.23",
    "wagmi": "^2.14.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.1.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "dotenv": "^16.4.7",
    "globals": "^15.14.0",
    "hardhat": "^2.22.18",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0"
  }
}
